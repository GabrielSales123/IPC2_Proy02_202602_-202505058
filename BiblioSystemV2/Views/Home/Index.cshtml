@{
    ViewData["Title"] = "Sistema de Catálogo";
}

<link rel="stylesheet" href="~/css/catalogo.css" />

<div class="app">
    <header class="header">
        <div>
            <h1>BiblioSystemv2</h1>
            <p>Gestión de libros y categorías</p>
        </div>

        <div class="header-actions">
            <label class="btn btn-secondary file-button">
                Cargar XML
                <input type="file"
                       id="archivoXml"
                       accept=".xml,application/xml,text/xml"
                       onchange="cargarXML(this)" />
            </label>

            <button class="btn btn-light" onclick="mostrarAyuda()">
                Ayuda
            </button>
        </div>
    </header>

    <section class="catalog-status" aria-label="Resumen del catálogo">
        <div>
            <span class="status-label">Libros</span>
            <strong id="cantidadLibros">0</strong>
        </div>

        <div>
            <span class="status-label">Categorías</span>
            <strong id="cantidadCategorias">0</strong>
        </div>

    </section>

    <main class="main-content">

        <section class="panel categorias-panel">

            <div class="panel-header">
                <div>
                    <h2>Categorías</h2>
                    <p>Organización jerárquica del catálogo</p>
                </div>

                <button class="btn btn-primary"
                        onclick="mostrarFormularioCategoria()">
                    + Agregar categoría
                </button>
            </div>

            <div class="category-layout catalog-browser">
                <section class="tree-container" aria-label="Navegador de categorías">
                    <div class="tree-header">
                        <strong>Navegador de carpetas</strong>
                        <span id="cantidadLibrosCarpeta" class="folder-count">Selecciona una carpeta</span>
                    </div>

                    <div id="arbolCategorias"
                         class="tree"
                         data-upload-url="@Url.Action("CargarCatalogo", "Home")"
                        data-graph-url="@Url.Action("GenerarGrafico", "Home")"
                         aria-live="polite">
                        <p class="browser-message">Selecciona un archivo XML para cargar el catálogo.</p>
                    </div>
                </section>

                <aside class="category-info book-info-panel" aria-live="polite">
                    <div class="book-info-heading">
                        <span class="status-label">Ficha del libro</span>
                        <h3 id="categoriaSeleccionada">Sin catálogo</h3>
                    </div>

                    <div id="libroSeleccionado" class="selected-category selected-book">
                        <p>No hay un catálogo cargado.</p>
                    </div>
                </aside>
            </div>

        </section>

        <section class="panel">

            <div class="panel-header">

                <div>
                    <h2>Gestión de libros</h2>
                    <p>Registrar, buscar y eliminar libros</p>
                </div>

            </div>


            <div class="forms-grid">

                
                <div class="form-card">

                    <h3>Registrar libro</h3>

                    <div class="form-group">
                        <label>ISBN</label>
                        <input type="text"
                               id="isbn"
                               placeholder="Ej. 100">
                    </div>

                    <div class="form-group">
                        <label>Título</label>
                        <input type="text"
                               id="titulo"
                               placeholder="Título del libro">
                    </div>

                    <div class="form-group">
                        <label>Autor</label>
                        <input type="text"
                               id="autor"
                               placeholder="Autor">
                    </div>

                    <div class="form-group">
                        <label>Categoría</label>

                        <select id="categoriaLibro">
                            <option value="">
                                Seleccionar categoría
                            </option>
                        </select>

                    </div>

                    <button class="btn btn-primary full-width"
                            onclick="registrarLibro()">

                        Registrar libro

                    </button>

                </div>


                <!-- BUSCAR -->
                <div class="form-card">

                    <h3>Buscar libro</h3>

                    <div class="form-group">

                        <label>ISBN</label>

                        <input type="text"
                               id="buscarIsbn"
                               placeholder="Ingrese ISBN">

                    </div>

                    <button class="btn btn-primary full-width"
                            onclick="buscarLibro()">

                        Buscar por ISBN

                    </button>

                    <div id="resultadoBusqueda"
                         class="search-result">

                        Ingrese un ISBN para realizar
                        una búsqueda.

                    </div>

                </div>


                <!-- ELIMINAR -->
                <div class="form-card">

                    <h3>Eliminar libro</h3>

                    <div class="form-group">

                        <label>ISBN</label>

                        <input type="text"
                               id="eliminarIsbn"
                               placeholder="ISBN del libro">

                    </div>

                    <button class="btn btn-danger full-width"
                            onclick="eliminarLibro()">

                        Eliminar libro

                    </button>

                </div>

            </div>

        </section>

        <section class="panel">

            <div class="panel-header">

                <div>
                    <h2>Consultas del catálogo</h2>
                    <p>Operaciones sobre los libros registrados</p>
                </div>

            </div>

            <div class="isbn-results" aria-live="polite">
                <p class="isbn-result">
                    <span>Menor ISBN</span>
                    <strong id="menorIsbn">--</strong>
                </p>

                <p class="isbn-result">
                    <span>Mayor ISBN</span>
                    <strong id="mayorIsbn">--</strong>
                </p>
            </div>

        </section>

        <section class="panel graphviz-panel">
            <div class="panel-header">
                <div>
                    <h2>Visualización gráfica con Graphviz</h2>
                    <p>Genera el árbol de categorías o el árbol de libros ordenado por ISBN</p>
                </div>
            </div>

            <div class="graphviz-controls">
                <div class="form-card graphviz-control">
                    <h3>Árbol de categorías</h3>
                    <div class="form-group">
                        <label for="graphCategorySelect">Categoría raíz del gráfico</label>
                        <select id="graphCategorySelect">
                            <option value="">Seleccionar categoría</option>
                        </select>
                    </div>
                    <button class="btn btn-primary full-width"
                            type="button"
                            data-graph-type="categorias"
                            data-category-select="graphCategorySelect">
                        Generar árbol de categorías
                    </button>
                </div>

                <div class="form-card graphviz-control">
                    <h3>Árbol binario de libros</h3>
                    <div class="form-group">
                        <label for="graphBooksSelect">Categoría de los libros</label>
                        <select id="graphBooksSelect">
                            <option value="">Seleccionar categoría</option>
                        </select>
                    </div>
                    <button class="btn btn-primary full-width"
                            type="button"
                            data-graph-type="libros"
                            data-category-select="graphBooksSelect">
                        Generar árbol de libros
                    </button>
                </div>
            </div>

            <div id="graphvizOutput" class="graphviz-output" aria-live="polite">
                <p class="browser-message">Carga un XML para generar gráficos.</p>
            </div>
        </section>

<script src="~/js/catalogo.js"></script>
